{
  "name": "print-bridge",
  "version": "1.0.0",
  "description": "Print Bridge — เชื่อมต่อเครื่องปริ้น LAN กับระบบ cloud",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icon.js",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22.12",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.restaurant.print-bridge",
    "productName": "Print Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
